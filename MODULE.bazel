module(
    name = "tasman_bazel_testing",
    version = "0.1.0",
)

# Bazel modules (bzlmod) is now enabled by default in Bazel 7+
# Add external dependencies here using bazel_dep()

bazel_dep(name = "abseil-cpp", version = "20240116.2")
bazel_dep(name = "imgui", version = "1.91.8")  
bazel_dep(name = "implot", version = "0.16")
bazel_dep(name = "googletest", version = "1.15.2")

# Override imgui to use docking branch  
archive_override(
    module_name = "imgui",
    urls = ["https://github.com/ocornut/imgui/archive/v1.91.7-docking.tar.gz"],
    strip_prefix = "imgui-1.91.7-docking",
    integrity = "sha256-sVv5vA7OgOZqZTkmRlYpeaIgPhw/+k8dSOuRJq01LBM=",
    patches = [
        "//third_party:imgui_module.patch",
        "//third_party:imgui_build.patch",
    ],
    patch_strip = 1,
)
